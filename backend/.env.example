# ─── Server ────────────────────────────────────────────────────────────────
PORT=4000
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# ─── Infra (matches docker-compose.yml) ────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/reachinbox
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=emails
ELASTICSEARCH_ENABLED=true

# ─── Auth ──────────────────────────────────────────────────────────────────
# Any long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=replace-with-a-long-random-string
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web)
# Authorized redirect URI: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local testing only: shows a "dev login" box and enables POST /api/auth/dev-login.
# Always disabled when NODE_ENV=production.
ALLOW_DEV_LOGIN=false

# ─── Slack OAuth (rate-limit alerts) ───────────────────────────────────────
# api.slack.com/apps → Create app → OAuth & Permissions
# Bot scopes: incoming-webhook, chat:write
# Slack requires an HTTPS redirect URL — use ngrok/cloudflared for local dev:
#   SLACK_REDIRECT_URI=https://<your-tunnel>/api/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=

# ─── Senders (Ethereal SMTP) ───────────────────────────────────────────────
# Option A: leave ETHEREAL_SENDERS empty and the server creates
#           AUTO_CREATE_ETHEREAL_SENDERS fresh Ethereal inboxes on first start.
# Option B: paste accounts you created at https://ethereal.email/create
# ETHEREAL_SENDERS=[{"name":"Sales 1","email":"xxx@ethereal.email","pass":"yyy"},{"name":"Sales 2","email":"zzz@ethereal.email","pass":"www"}]
ETHEREAL_SENDERS=
AUTO_CREATE_ETHEREAL_SENDERS=2
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587

# ─── Throughput & rate limiting ────────────────────────────────────────────
# Parallel jobs per worker process
WORKER_CONCURRENCY=5
# Minimum gap between two sends from the same sender (ms)
MIN_DELAY_BETWEEN_EMAILS_MS=2000
# Hourly cap per sender, enforced with Redis counters across all workers
MAX_EMAILS_PER_HOUR_PER_SENDER=50
# Length of a rate-limit window (ms). Lower it (e.g. 60000) to demo limits quickly.
RATE_LIMIT_WINDOW_MS=3600000
# Retries for SMTP failures (exponential backoff)
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_MS=10000
# How long a row may stay "processing" before a crashed attempt is taken over
STALE_PROCESSING_MS=120000

# Run the worker inside the API process (simplest local setup).
# Set to false and run `npm run dev:worker` separately to scale workers.
RUN_WORKER_IN_API=false

# Optional basic auth for Bull Board at /admin/queues
BULL_BOARD_USER=
BULL_BOARD_PASS=
